diff --git a/crates/rustc-codegen-cuda/examples/read_only_load/src/main.rs b/crates/rustc-codegen-cuda/examples/read_only_load/src/main.rs
new file mode 100644
index 0000000..7e42531
--- /dev/null
+++ b/crates/rustc-codegen-cuda/examples/read_only_load/src/main.rs
@@ -0,0 +1,39 @@
+use cuda_core::{CudaContext, DeviceBuffer, LaunchConfig};
+use cuda_device::cuda_module;
+
+#[cuda_module]
+mod kernels {
+    use cuda_device::{DisjointSlice, kernel, read_only, thread};
+    use cuda_device::vector::{I32x4, as_vectors};
+
+    #[kernel]
+    pub fn sum_quads(input: &[i32], mut output: DisjointSlice<i32>) {
+        let index = thread::index_1d();
+        let lane = index.get();
+        if let Some(out) = output.get_mut(index)
+            && let Some(quads) = as_vectors::<I32x4>(input)
+            && let Some(quad) = quads.get(lane)
+        {
+            let lanes = read_only::load(quad).to_array();
+            *out = lanes[0] + lanes[1] + lanes[2] + lanes[3];
+        }
+    }
+}
+
+fn main() {
+    let context = CudaContext::new(0).expect("context");
+    let stream = context.default_stream();
+    let input = DeviceBuffer::from_host(&stream, &[1i32, 2, 3, 4, 5, 6, 7, 8]).expect("input");
+    let mut output = DeviceBuffer::<i32>::zeroed(&stream, 2).expect("output");
+    let module = kernels::load(&context).expect("module");
+    unsafe {
+        module.sum_quads(
+            &stream,
+            LaunchConfig::for_num_elems(2),
+            &input,
+            &mut output,
+        )
+    }
+    .expect("launch");
+    assert_eq!(output.to_host_vec(&stream).expect("copy"), [10, 26]);
+}
diff --git a/crates/rustc-codegen-cuda/examples/read_only_load/verify-code-shape.sh b/crates/rustc-codegen-cuda/examples/read_only_load/verify-code-shape.sh
new file mode 100644
index 0000000..854bb31
--- /dev/null
+++ b/crates/rustc-codegen-cuda/examples/read_only_load/verify-code-shape.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ptx="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/read_only_load.ptx"
+test -s "$ptx"
+count="$(rg -c 'ld\.global\.nc\.v2\.u64' "$ptx")"
+test "$count" -eq 1
+if rg 'ld\.global\.nc\.(u32|b32)' "$ptx"; then
+    printf '%s\n' 'read-only quad was scalarized' >&2
+    exit 1
+fi
+printf '%s\n' 'read-only vector load code shape: PASS'
