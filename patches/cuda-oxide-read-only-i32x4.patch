+pub fn emit_read_only_load_address_at(
+    ctx: &mut Context,
+    body: &mir::Body,
+    args: &[mir::Operand],
+    destination: &mir::Place,
+    target: &Option<usize>,
+    block_ptr: Ptr<BasicBlock>,
+    prev_op: Option<Ptr<Operation>>,
+    value_map: &mut ValueMap,
+    block_map: &[Ptr<BasicBlock>],
+    loc: Location,
+) -> TranslationResult<Ptr<Operation>> {
+    use dialect_mir::ops::{MirLoadOp, MirPtrOffsetOp};
+
+    if args.len() != 2 {
+        return input_err!(
+            loc.clone(),
+            TranslationErr::unsupported(format!(
+                "read_only::__load_address_at expects a u64 address and index, got {} arguments",
+                args.len()
+            ))
+        );
+    }
+
+    let (integer_address, after_address) = rvalue::translate_operand(
+        ctx,
+        body,
+        &args[0],
+        value_map,
+        block_ptr,
+        prev_op,
+        loc.clone(),
+    )?;
+    let address_ty = integer_address.get_type(ctx);
+    let is_u64_address = address_ty
+        .deref(ctx)
+        .downcast_ref::<IntegerType>()
+        .is_some_and(|integer| integer.width() == 64);
+    if !is_u64_address {
+        return input_err!(
+            loc.clone(),
+            TranslationErr::unsupported(
+                "read_only::__load_address_at address is not a 64-bit integer".to_string()
