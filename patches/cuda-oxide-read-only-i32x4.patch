+        ctx,
+        MirCastOp::get_concrete_op_info(),
+        vec![data_ty],
+        vec![integer_address],
+        vec![],
+        0,
+    );
+    cast.deref_mut(ctx).set_loc(loc.clone());
+    let cast_boundary = MirCastOp::new(cast);
+    cast_boundary.set_attr_cast_kind(ctx, MirCastKindAttr::PointerWithExposedProvenance);
+    cast_boundary.set_pointer_kind_authority(ctx, MirPointerKindAuthorityAttr::RustCast);
+    match after_address {
+        Some(previous) => cast.insert_after(ctx, previous),
+        None => cast.insert_at_front(block_ptr, ctx),
+    }
+
+    let data = cast.deref(ctx).get_result(0);
+    let (index, after_index) = rvalue::translate_operand(
+        ctx,
+        body,
+        &args[1],
+        value_map,
+        block_ptr,
+        Some(cast),
+        loc.clone(),
+    )?;
+    let offset = Operation::new(
+        ctx,
+        MirPtrOffsetOp::get_concrete_op_info(),
+        vec![data_ty],
+        vec![data, index],
+        vec![],
+        0,
+    );
+    offset.deref_mut(ctx).set_loc(loc.clone());
+    MirPtrOffsetOp::new(offset).set_inbounds(ctx, true);
+    match after_index {
+        Some(previous) => offset.insert_after(ctx, previous),
+        None => offset.insert_after(ctx, cast),
+    }
+
+    let address = offset.deref(ctx).get_result(0);
+    let load = Operation::new(
+        ctx,
+        MirLoadOp::get_concrete_op_info(),
+        vec![element_ty],
+        vec![address],
+        vec![],
+        0,
+    );
+    load.deref_mut(ctx).set_loc(loc.clone());
+    MirLoadOp::new(load).set_read_only(ctx, true);
+    load.insert_after(ctx, offset);
+
+    let result = load.deref(ctx).get_result(0);
+    emit_store_result_and_goto(
+        ctx,
+        destination,
+        result,
+        target,
+        block_ptr,
+        load,
+        value_map,
+        block_map,
+        loc,
+        "read_only::__load_address_at call without target block",
+    )
