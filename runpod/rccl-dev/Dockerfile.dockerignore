# The repository root is the build context, but only image inputs are admitted.
**
!runpod/
!runpod/rccl-dev/
!runpod/rccl-dev/Dockerfile
!runpod/rccl-dev/self-check.sh

# Defense in depth: credentials, keys, environment files, and common secrets
# remain excluded even if future context exceptions are broadened.
**/.cargo/credentials
**/.cargo/credentials.toml
**/.docker/config.json
**/.env
**/.env.*
**/.git-credentials
**/.netrc
**/.npmrc
**/.pypirc
**/.ssh/**
**/*credential*
**/*secret*
**/*token*
**/id_rsa*
**/id_ed25519*
